@page "/series"
@using ClientBlazorSeries.ViewModels
@inject SeriesViewModel ViewModel

<div class="container-fluid py-4 px-md-5">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pb-4 mb-4 border-bottom">
        <div>
            <h1 class="fw-extrabold display-6 text-gradient m-0">🎬 CineSeries Hub</h1>
            <p class="text-muted small m-0 mt-1">Explorați și administrați catalogul vostru complet de seriale</p>
        </div>

        <!-- Action Bar -->
        <div class="d-flex flex-wrap gap-2 mt-3 mt-md-0 align-items-center">
            <button class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm rounded-pill px-3 py-2"
                    @onclick="() => ViewModel.LoadSeriesCommand.ExecuteAsync(null)"
                    disabled="@(ViewModel.LoadSeriesCommand.IsRunning || ViewModel.LoadSeriesSlowCommand.IsRunning)">
                <span class="bi bi-arrow-clockwise"></span>
                <span>Reîncarcă</span>
            </button>

            <button class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 rounded-pill px-3 py-2"
                    @onclick="() => ViewModel.LoadSeriesSlowCommand.ExecuteAsync(null)"
                    disabled="@(ViewModel.LoadSeriesCommand.IsRunning || ViewModel.LoadSeriesSlowCommand.IsRunning)">
                <span class="bi bi-hourglass-split"></span>
                <span>Test Rețea Lentă</span>
            </button>

            @if (ViewModel.LoadSeriesCommand.IsRunning || ViewModel.LoadSeriesSlowCommand.IsRunning)
            {
                <button class="btn btn-outline-danger d-inline-flex align-items-center gap-2 rounded-pill px-3 py-2 pulse-btn"
                        @onclick="() => { ViewModel.LoadSeriesCommand.Cancel(); ViewModel.LoadSeriesSlowCommand.Cancel(); }">
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    <span>Anulează</span>
                </button>
            }
        </div>
    </div>

    <!-- Alert / Status -->
    @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center gap-3 rounded-4 mb-4">
            <span class="fs-4">⚠️</span>
            <div>@ViewModel.ErrorMessage</div>
        </div>
    }

    <!-- Series Grid -->
    @if (ViewModel.Series != null && ViewModel.Series.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var serie in ViewModel.Series)
            {
                <div class="col">
                    <div class="card h-100 modern-card border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                        <div class="card-header-accent"></div>
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge bg-light text-primary border rounded-pill px-2 py-1 small">
                                        @(string.IsNullOrEmpty(serie.Network) ? "Necunoscut" : serie.Network)
                                    </span>
                                    <span class="text-muted small fw-semibold">ID #@serie.SerieId</span>
                                </div>
                                <h5 class="card-title fw-bold text-dark mb-2">@serie.Titre</h5>
                                <p class="card-text text-muted small text-truncate-2">
                                    @(string.IsNullOrWhiteSpace(serie.Resume) ? "Fără descriere disponibilă..." : serie.Resume)
                                </p>
                            </div>

                            <div class="mt-4 pt-3 border-top">
                                <div class="d-flex justify-content-between text-muted small mb-3">
                                    <span><strong>@(serie.NbSaisons ?? 0)</strong> Sezoane</span>
                                    <span>•</span>
                                    <span><strong>@(serie.NbEpisodes ?? 0)</strong> Episoade</span>
                                </div>
                                <a href="/series/@serie.SerieId" class="btn btn-light-primary w-100 rounded-pill fw-semibold py-2">
                                    Editează Detalii →
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (!ViewModel.LoadSeriesCommand.IsRunning && !ViewModel.LoadSeriesSlowCommand.IsRunning)
    {
        <div class="text-center py-5 text-muted">
            <div class="fs-1 mb-2">📭</div>
            <p>Nu a fost găsit niciun serial în catalog.</p>
        </div>
    }
</div>

<style>
    .text-gradient {
        background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .modern-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        background: #fff;
    }
    .modern-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 25px rgba(0, 0, 0, 0.08) !important;
    }
    .card-header-accent {
        height: 6px;
        background: linear-gradient(90deg, #0d6efd, #0dcaf0);
    }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .btn-light-primary {
        background-color: #e7f1ff;
        color: #0d6efd;
        border: none;
        transition: all 0.2s ease;
    }
    .btn-light-primary:hover {
        background-color: #0d6efd;
        color: #fff;
    }
    .pulse-btn {
        animation: pulse 1.5s infinite;
    }
    @@keyframes pulse {
        0% { opacity: 1; }
        50% { opacity: 0.6; }
        100% { opacity: 1; }
    }
</style>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadSeriesCommand.ExecuteAsync(null);
    }
}