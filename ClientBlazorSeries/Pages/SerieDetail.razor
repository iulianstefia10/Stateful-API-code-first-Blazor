@page "/series/{Id:int}"
@using ClientBlazorSeries.ViewModels
@inject SerieDetailViewModel ViewModel

<div class="container py-5" style="max-width: 850px;">
    <!-- Top Back Navigation -->
    <div class="mb-4">
        <a href="/series" class="text-decoration-none text-muted small fw-semibold d-inline-flex align-items-center gap-1 hover-back">
            <span>← Înapoi la catalog</span>
        </a>
    </div>

    <!-- Status Alerts -->
    @if (!string.IsNullOrEmpty(ViewModel.StatusMessage))
    {
        <div class="alert @(ViewModel.IsSuccess ? "alert-success border-success" : "alert-info border-info") shadow-sm rounded-4 mb-4 d-flex align-items-center gap-2">
            <span>@(ViewModel.IsSuccess ? "✅" : "ℹ️")</span>
            <span>@ViewModel.StatusMessage</span>
        </div>
    }

    @if (ViewModel.Serie != null)
    {
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="p-4 text-white" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
                <span class="badge bg-primary rounded-pill mb-2 px-3 py-1">Editare Serial</span>
                <h2 class="fw-bold mb-0">@(string.IsNullOrWhiteSpace(ViewModel.Serie.Titre) ? "Fără Nume" : ViewModel.Serie.Titre)</h2>
            </div>

            <div class="card-body p-4 p-md-5">
                <EditForm Model="@ViewModel.Serie" OnValidSubmit="() => ViewModel.SaveCommand.ExecuteAsync(null)">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger rounded-3" />

                    <!-- Titre -->
                    <div class="mb-4">
                        <label class="form-label fw-bold small text-uppercase text-muted">Titlul Serialului *</label>
                        <InputText class="form-control form-control-lg rounded-3 shadow-none border-2" @bind-Value="ViewModel.Serie.Titre" placeholder="ex: Breaking Bad" />
                        <ValidationMessage For="@(() => ViewModel.Serie.Titre)" class="text-danger small mt-1" />
                    </div>

                    <!-- Rezumat -->
                    <div class="mb-4">
                        <label class="form-label fw-bold small text-uppercase text-muted">Rezumat / Sinopsis</label>
                        <InputTextArea rows="4" class="form-control rounded-3 shadow-none border-2" @bind-Value="ViewModel.Serie.Resume" placeholder="Descrieți pe scurt povestea..." />
                    </div>

                    <!-- Date Numerice -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-uppercase text-muted">Nr. Sezoane</label>
                            <InputNumber class="form-control rounded-3 shadow-none border-2" @bind-Value="ViewModel.Serie.NbSaisons" />
                            <ValidationMessage For="@(() => ViewModel.Serie.NbSaisons)" class="text-danger small mt-1" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-uppercase text-muted">Nr. Episoade</label>
                            <InputNumber class="form-control rounded-3 shadow-none border-2" @bind-Value="ViewModel.Serie.NbEpisodes" />
                            <ValidationMessage For="@(() => ViewModel.Serie.NbEpisodes)" class="text-danger small mt-1" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-uppercase text-muted">Canal / Rețea</label>
                            <InputText class="form-control rounded-3 shadow-none border-2" @bind-Value="ViewModel.Serie.Network" placeholder="ex: Netflix, HBO" />
                        </div>
                    </div>

                    <!-- Stats Card -->
                    <div class="bg-light p-4 rounded-4 border mb-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                        <div>
                            <div class="text-muted small text-uppercase fw-bold">Medie Episoade / Sezon</div>
                            <div class="fs-4 fw-extrabold text-primary">@ViewModel.Serie.AverageEpisodesPerSeason <span class="fs-6 text-muted fw-normal">ep/sezon</span></div>
                        </div>

                        <div class="form-check form-switch fs-5">
                            <InputCheckbox class="form-check-input" id="inProgressSwitch" @bind-Value="ViewModel.Serie.IsInProgress" />
                            <label class="form-check-label fs-6 fw-semibold ms-2 align-middle" for="inProgressSwitch">
                                Difuzare în curs
                            </label>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm" disabled="@ViewModel.SaveCommand.IsRunning">
                            @(ViewModel.SaveCommand.IsRunning ? "Se salvează..." : "Salvează Modificările")
                        </button>

                        @if (ViewModel.SaveCommand.IsRunning)
                        {
                            <button type="button" class="btn btn-outline-danger btn-lg rounded-pill px-4" @onclick="() => ViewModel.SaveCommand.Cancel()">
                                Anulează
                            </button>
                        }
                    </div>
                </EditForm>
            </div>
        </div>
    }
    else if (ViewModel.LoadDetailCommand.IsRunning)
    {
        <div class="d-flex justify-content-center align-items-center py-5">
            <div class="spinner-grow text-primary" role="status">
                <span class="visually-hidden">Se încarcă...</span>
            </div>
        </div>
    }
</div>

<style>
    .hover-back:hover {
        color: #0d6efd !important;
        transform: translateX(-3px);
        transition: all 0.2s ease;
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadDetailCommand.ExecuteAsync(Id);
    }
}