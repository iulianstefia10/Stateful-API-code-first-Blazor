@page "/seriedetail"
@page "/series/edit/{Id:int}"
@using ClientBlazorSeries.ViewModels
@using System.ComponentModel
@inject SerieDetailViewModel ViewModel
@inject NavigationManager Navigation
@implements IDisposable

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-primary mb-0">Détails et Modification de la Série</h3>

        
        <div class="d-flex align-items-center">
            <label class="me-2 fw-semibold">ID Série :</label>
            <input type="number" class="form-control form-control-sm me-2" style="width: 80px;" @bind="SelectedId" min="1" />
            <button class="btn btn-sm btn-outline-primary" 
                    @onclick="() => ViewModel.LoadDetailCommand.ExecuteAsync(SelectedId)"
                    disabled="@ViewModel.LoadDetailCommand.IsRunning">
                Charger
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewModel.StatusMessage))
    {
        <div class="alert @(ViewModel.IsSuccess ? "alert-success" : "alert-info")">
            @ViewModel.StatusMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
    {
        <div class="alert alert-danger">
            ⚠️ @ViewModel.ErrorMessage
        </div>
    }

    @if (ViewModel.LoadDetailCommand.IsRunning)
    {
        <div class="d-flex align-items-center my-4">
            <div class="spinner-border text-primary me-2" role="status"></div>
            <span>Chargement des détails de la série...</span>
        </div>
    }
    else if (ViewModel.Serie != null)
    {
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-dark text-white p-3">
                <span class="badge bg-primary mb-1">Modification de la série #@ViewModel.Serie.SerieId</span>
                <h4 class="mb-0">@(string.IsNullOrWhiteSpace(ViewModel.Serie.Titre) ? "Sans titre" : ViewModel.Serie.Titre)</h4>
            </div>

            <div class="card-body p-4">
                <EditForm Model="ViewModel.Serie" OnValidSubmit="() => ViewModel.SaveCommand.ExecuteAsync(null)">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Titre de la série :</label>
                        <InputText class="form-control" @bind-Value="ViewModel.Serie.Titre" />
                        <ValidationMessage For="@(() => ViewModel.Serie.Titre)" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Résumé :</label>
                        <InputTextArea class="form-control" rows="3" @bind-Value="ViewModel.Serie.Summary" />
                        <ValidationMessage For="@(() => ViewModel.Serie.Summary)" class="text-danger" />
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold">Nombre de saisons :</label>
                            <InputNumber class="form-control" @bind-Value="ViewModel.Serie.Seasons" />
                            <ValidationMessage For="@(() => ViewModel.Serie.Seasons)" class="text-danger" />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold">Nombre d'épisodes :</label>
                            <InputNumber class="form-control" @bind-Value="ViewModel.Serie.Episodes" />
                            <ValidationMessage For="@(() => ViewModel.Serie.Episodes)" class="text-danger" />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold">Année de création :</label>
                            <InputNumber class="form-control" @bind-Value="ViewModel.Serie.CreationYear" />
                            <ValidationMessage For="@(() => ViewModel.Serie.CreationYear)" class="text-danger" />
                        </div>
                    </div>

                    <div class="mb-3 form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="ViewModel.Serie.IsInProgress" />
                        <label class="form-check-label fw-semibold">
                            Série en cours de production (IsInProgress)
                        </label>
                    </div>

                    <div class="alert alert-light border mb-4">
                        <strong>Moyenne d'épisodes par saison (AverageEpisodesPerSeason) :</strong> 
                        <span class="badge bg-secondary fs-6 ms-2">@ViewModel.Serie.AverageEpisodesPerSeason</span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success" disabled="@ViewModel.SaveCommand.IsRunning">
                            @if (ViewModel.SaveCommand.IsRunning)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Enregistrer les modifications
                        </button>

                        @if (ViewModel.SaveCommand.CanBeCanceled)
                        {
                            <button type="button" class="btn btn-danger" @onclick="() => ViewModel.SaveCommand.Cancel()">
                                Annuler la sauvegarde
                            </button>
                        }

                        <button type="button" class="btn btn-outline-secondary ms-auto" @onclick='() => Navigation.NavigateTo("/series")'>
                            Retour au catalogue
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private int SelectedId { get; set; } = 1;

    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += OnViewModelPropertyChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
       
        SelectedId = Id > 0 ? Id : 1;
        await ViewModel.LoadDetailCommand.ExecuteAsync(SelectedId);
    }

    private void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
    }
}