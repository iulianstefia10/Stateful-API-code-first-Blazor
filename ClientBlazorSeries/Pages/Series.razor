@page "/series"
@using ClientBlazorSeries.ViewModels
@using System.ComponentModel
@inject SeriesViewModel ViewModel
@implements IDisposable

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-0">🎬 Catalogue des Séries</h2>
            <p class="text-muted mb-0">Explorez et gérez votre catalogue complet de séries</p>
        </div>
        <div>
            <button class="btn btn-primary me-2" 
                    @onclick="() => ViewModel.LoadSeriesCommand.ExecuteAsync(null)" 
                    disabled="@IsBusy">
                Recharger (Normal)
            </button>

            <button class="btn btn-outline-secondary me-2" 
                    @onclick="() => ViewModel.LoadSeriesSlowCommand.ExecuteAsync(null)" 
                    disabled="@IsBusy">
                Recharger (Réseau lent)
            </button>

            @if (ViewModel.LoadSeriesCommand.CanBeCanceled)
            {
                <button class="btn btn-danger" @onclick="() => ViewModel.LoadSeriesCommand.Cancel()">
                    Annuler
                </button>
            }

            @if (ViewModel.LoadSeriesSlowCommand.CanBeCanceled)
            {
                <button class="btn btn-danger" @onclick="() => ViewModel.LoadSeriesSlowCommand.Cancel()">
                    Annuler le chargement lent
                </button>
            }
        </div>
    </div>

    @if (IsBusy)
    {
        <div class="d-flex align-items-center alert alert-secondary">
            <div class="spinner-border text-primary me-3" role="status"></div>
            <span>Chargement des séries en cours... Veuillez patienter.</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(ViewModel.StatusMessage))
    {
        <div class="alert alert-info">@ViewModel.StatusMessage</div>
    }

    @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
    {
        <div class="alert alert-warning">
            ⚠️ @ViewModel.ErrorMessage
        </div>
    }

    @if (!IsBusy && ViewModel.Series != null && ViewModel.Series.Any())
    {
        <table class="table table-hover table-striped shadow-sm align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Titre</th>
                    <th>Saisons</th>
                    <th>Épisodes</th>
                    <th>Année de création</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
    @foreach (var serie in ViewModel.Series)
    {
        <tr>
            <td>@serie.SerieId</td>
            <td class="fw-bold">@serie.Title</td>
            <td>@serie.NbSaisons</td>
            <td>@serie.NbEpisodes</td>
            <td>@serie.CreationYear</td>
            <td>
                <a href="/series/edit/@serie.SerieId" class="btn btn-sm btn-primary">
                    Détails / Modifier
                </a>
            </td>
        </tr>
    }
</tbody>
        </table>
    }
    else if (!IsBusy)
    {
        <div class="text-center text-muted my-5">
            <p class="fs-5">Aucune série trouvée dans le catalogue.</p>
        </div>
    }
</div>

@code {
    private bool IsBusy => ViewModel.LoadSeriesCommand.IsRunning || ViewModel.LoadSeriesSlowCommand.IsRunning;

    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += OnViewModelPropertyChanged;
        await ViewModel.LoadSeriesCommand.ExecuteAsync(null);
    }

    private void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
    }
}